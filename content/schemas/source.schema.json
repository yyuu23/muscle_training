{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge source metadata",
  "description": "知识来源元数据结构（plan §5.7）。新导入默认 private；共享需管理员独立操作。",
  "type": "object",
  "required": ["title", "source_type", "visibility"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "author": { "type": "string", "maxLength": 200 },
    "original_url": {
      "type": "string",
      "format": "uri",
      "description": "仅作为元数据；服务器不抓取任意 URL"
    },
    "source_type": { "enum": ["video", "audio", "document", "subtitle"] },
    "visibility": { "enum": ["private", "shared"], "default": "private" },
    "status": {
      "enum": ["processing", "awaiting_review", "indexing", "ready", "failed", "withdrawn"]
    },
    "active_revision_id": { "type": "string", "format": "uuid" }
  },
  "additionalProperties": false
}
