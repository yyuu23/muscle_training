# ============================================================
# 环境配置示例（plan §11.1）——不含真实密钥
# 开发默认值可直接使用；标注【生产必填】的项在 PYTHON_ENV=production 时强制校验
# 复制为 .env 使用；.env 不进入版本控制
# ============================================================

# --- 应用环境 ------------------------------------------------
PYTHON_ENV=development            # development | test | production
DEBUG=false
APP_BASE_URL=http://localhost:5173   # 【生产必填】同域部署的对外地址
APP_TIMEZONE=Asia/Shanghai
DEMO_MODE=false                   # 生产禁止 true

# --- 安全 ----------------------------------------------------
APP_SECRET=change-me-to-random-32-chars-minimum   # 【生产必填】≥32字符随机串
SESSION_EXPIRE_DAYS=7             # 会话绝对有效期
INVITE_CODE_EXPIRE_HOURS=72       # 邀请码 72 小时一次性使用

# --- 数据库 --------------------------------------------------
DATABASE_URL=postgresql+asyncpg://muscle_training:dev_password@localhost:5432/muscle_training_dev
# 分角色连接串（plan §9.3；缺省回退 DATABASE_URL）
MIGRATION_DATABASE_URL=
JOB_DATABASE_URL=
BACKUP_DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- 模型（百炼/DashScope）-----------------------------------
MODEL_PROVIDER=qwen               # qwen | fake（fake 仅开发测试；生产禁止）
DASHSCOPE_API_KEY=                # 缺省时记录功能不受影响，模型功能显示未配置
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus-2025-12-01
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
ASR_MODEL=paraformer-v2

# --- 预算与 Agent 限制（plan §7.1 / §11.4）------------------
MONTHLY_AI_BUDGET_CNY=100         # 初始 AI 月预算；80% 提醒；耗尽暂停生成
MAX_AGENT_MODEL_CALLS=3           # 单次交互最多模型调用
MAX_AGENT_TOOL_CALLS=6            # 单次交互最多只读工具调用
INTERACTIVE_TIMEOUT_SECONDS=60
PLAN_JOB_TIMEOUT_SECONDS=180
MAX_CONTEXT_TOKENS=12000

# --- 对象存储 ------------------------------------------------
STORAGE_PROVIDER=filesystem       # filesystem（开发） | oss（生产）
LOCAL_STORAGE_ROOT=./storage      # 开发本地目录
OSS_REGION=cn-beijing             # 【生产必填 when oss】
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=muscle-training-prod        # 私有 Bucket
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# --- 备份（plan §9.6）----------------------------------------
BACKUP_BUCKET=muscle-training-backups  # 独立备份 Bucket（只写备份凭据）
BACKUP_AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # 【生产必填】age 公钥
BACKUP_RETENTION_DAILY=7          # 最近 7 个日备份
BACKUP_RETENTION_WEEKLY=4         # 4 个周备份
BACKUP_AGE_BINARY=age             # age 可执行文件路径

# --- 媒体处理 ------------------------------------------------
MEDIA_MAX_SIZE_MB=500             # 单个视频上限
MEDIA_MAX_DURATION_MINUTES=60     # 单个视频最长时长
FFMPEG_PATH=ffmpeg                # FFmpeg 可执行文件（参数数组调用，不拼 shell）
FFPROBE_PATH=ffprobe
TEMP_MEDIA_RETENTION_DAYS=7       # 原视频/音频临时保留 7 天
CHAT_RETENTION_DAYS=90            # 普通对话原文保留 90 天

# --- 后台任务 ------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_LEASE_TIMEOUT_SECONDS=60
WORKER_LEASE_RENEW_SECONDS=20
WORKER_MAX_ATTEMPTS=3
WORKER_MEDIA_CONCURRENCY=1        # 媒体处理并发 1
WORKER_GENERATION_CONCURRENCY=2   # 生成任务并发 2

# --- 日志 ----------------------------------------------------
LOG_LEVEL=INFO

# --- 功能开关 ------------------------------------------------
ENABLE_SIGNUP=true
ENABLE_AGENT=true                 # false 时 /chat 返回未启用
ENABLE_KNOWLEDGE_IMPORT=true
ENABLE_WEEKLY_REVIEW=true

# --- 速率限制 ------------------------------------------------
RATE_LIMIT_AUTH_ATTEMPTS=5        # 15 分钟窗口内登录失败次数
RATE_LIMIT_AUTH_WINDOW_MINUTES=15

# --- 前端（Vite）---------------------------------------------
VITE_API_BASE_URL=                # 开发留空走同源代理；生产同域部署无需设置
