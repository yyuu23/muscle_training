# Environment
NODE_ENV=development
PYTHON_ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://muscle_training:dev_password@localhost:5432/muscle_training_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (if needed later)
# REDIS_URL=redis://localhost:6379/0

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000/ws

# Security
SECRET_KEY=changeme_random_secret_key_minimum_32_characters
SESSION_EXPIRE_DAYS=7
INVITE_CODE_EXPIRE_HOURS=72

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Alibaba Cloud DashScope (百炼)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Model Configuration
DEFAULT_CHAT_MODEL=qwen-plus-2025-12-01
DEFAULT_EMBEDDING_MODEL=qwen3.7-text-embedding
DEFAULT_ASR_MODEL=paraformer-v2
EMBEDDING_DIMENSION=1024

# Model Budget (RMB per month)
MODEL_BUDGET_MONTHLY=100.0
MODEL_BUDGET_WARNING_THRESHOLD=0.8

# Storage
STORAGE_BACKEND=filesystem  # filesystem | oss
STORAGE_BASE_PATH=./storage

# Alibaba Cloud OSS (production)
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET_NAME=muscle-training-prod
OSS_BACKUP_BUCKET_NAME=muscle-training-backups

# Media Processing
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
MAX_VIDEO_SIZE_MB=500
MAX_AUDIO_SIZE_MB=100
MAX_DOCUMENT_SIZE_MB=10

# Background Jobs
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_LEASE_TIMEOUT_SECONDS=300
WORKER_MAX_ATTEMPTS=3

# Backup
BACKUP_SCHEDULE=0 3 * * *  # Daily at 3 AM
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_ENCRYPTION_PASSPHRASE=changeme_strong_backup_passphrase

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json  # json | text

# Feature Flags
ENABLE_SIGNUP=true
ENABLE_AGENT=true
ENABLE_KNOWLEDGE_IMPORT=true
ENABLE_WEEKLY_REVIEW=true

# Rate Limiting
RATE_LIMIT_AUTH_ATTEMPTS=5
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_API_REQUESTS=100
RATE_LIMIT_API_WINDOW_MINUTES=1

# Timezone
DEFAULT_TIMEZONE=Asia/Shanghai

# Development Tools
ENABLE_DEBUG_TOOLBAR=false
ENABLE_QUERY_LOGGING=false
